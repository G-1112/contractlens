# =============================================================
# 契约眼 环境变量模板（复制为 .env 后填写）
# 复现指南见 README.md「10 分钟极速复现」
# =============================================================

# ---- LLM 配置（任选一家，OpenAI 兼容协议） ----
# DeepSeek（推荐，成本最低）
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 或 通义千问：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 或 智谱 GLM：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# ---- LLM 行为 ----
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# ---- 检索器 ----
# true = 使用 ChromaDB + 本地 embedding（需 pip install -e ".[vectordb]"）
# false = 使用纯 Python 字符级 TF-IDF 检索器（零额外依赖，默认）
USE_VECTOR_DB=false

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000
# 上传文件临时目录（分析完成立即删除，不持久化）
UPLOAD_DIR=data/uploads
# 单文件大小上限（字节，默认 20MB）
MAX_UPLOAD_BYTES=20971520
