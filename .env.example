# =============================================================
# 契约眼 环境变量模板（复制为 .env 后填写）
# 复现指南见 README.md「10 分钟极速复现」
# =============================================================

# ---- 公网部署保险丝 ----
# PUBLIC_DEPLOY=1 时服务**强制离线**：即便目录里意外带了 LLM_API_KEY 也不会使用
# （读都读不到），公网任意用户都无法触发模型调用、无法消耗额度。
# 演示实例一律置1；本地开发不要置。
#
# ⚠️ 关键：真实 .env **不要放在本项目目录内**。部署工具压缩整个目录上传
# （只排除 node_modules/.git/构建产物），.gitignore 对此无效——放在目录里的
# .env 会被一并上传到公网沙箱。本项目的 Key 存放在<workspace>/.secrets/，
# 本地需要时用环境变量注入：
#   PowerShell: $env:LLM_API_KEY="sk-..."; python -m uvicorn api.main:app
PUBLIC_DEPLOY=

# ---- 评审访问口令 ----
# 留空 = 不启用门禁（本地默认）。公网演示建议设置一个随机口令，
# 提交作品时把该口令作为「账号密码」填在报名平台。
# 访问时二选一：请求头 X-Review-Code，或查询参数 ?code=
REVIEW_ACCESS_CODE=

# ---- LLM 配置（任选一家，OpenAI 兼容协议） ----
# DeepSeek（推荐，成本最低）
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 或 通义千问：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 或 智谱 GLM：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# ---- LLM 行为 ----
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# ---- 检索器 ----
# true = 使用 ChromaDB + 本地 embedding（需 pip install -e ".[vectordb]"）
# false = 使用纯 Python 字符级 TF-IDF 检索器（零额外依赖，默认）
USE_VECTOR_DB=false

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000
# 上传文件临时目录（分析完成立即删除，不持久化）
UPLOAD_DIR=data/uploads
# 单文件大小上限（字节，默认 20MB）
MAX_UPLOAD_BYTES=20971520
